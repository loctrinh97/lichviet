<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_light"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_weekday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#75798C"
        android:textAllCaps="true"
        android:text="THỨ TƯ" />

    <TextView
        android:id="@+id/widget_solar_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1C1D26"
        android:text="9" />

    <TextView
        android:id="@+id/widget_lunar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#5D5294"
        android:text="Âm 1/1" />

    <TextView
        android:id="@+id/widget_auspicious"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#5D5294"
        android:text="" />

    <TextView
        android:id="@+id/widget_holiday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#796CBF"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <TextView
        android:id="@+id/widget_upcoming_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#27AE82"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

</LinearLayout>
